# =============================================================================
# Application Configuration
# =============================================================================
APP_NAME="OnTask AI Summary Service"
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# CORS Whitelist (comma-separated origins) -- the OnTask Next.js app's origin(s)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Multi-Provider LLM Gateway Settings
# =============================================================================
GATEWAY_MAX_ATTEMPTS=10
GATEWAY_COOLDOWN_SECONDS=60

# Daily Summary Generation (Phase 10)
SUMMARY_TEMPERATURE=0.2
SUMMARY_MAX_VALIDATION_RETRIES=1

# 1. Google Gemini (supports up to 4 rotated keys for quota headroom)
GOOGLE_API_KEY1=your_google_api_key_here
GOOGLE_API_KEY2=
GOOGLE_API_KEY3=
GOOGLE_API_KEY4=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# 2. Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# 3. OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 4. Mistral
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# 5. Cerebras
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=qwen-3.8-27b

# At least one provider above must be configured. Deployments are tried in the
# order listed (Gemini keys, then Groq, OpenAI, Mistral, Cerebras); leave any
# provider's key blank to skip it entirely.
